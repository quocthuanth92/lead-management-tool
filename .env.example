NODE_ENV=development

# lead-web
LEAD_WEB_PORT=3000
LEAD_SERVICE_URL=http://localhost:3001
SESSION_COOKIE_NAME=lead_session
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_APP_NAME=Lead Management

# lead-service
LEAD_SERVICE_PORT=3001
MONGODB_URI=mongodb://mongo:27017/lead
REDIS_URL=redis://redis:6379
JWT_SECRET=please-change-this-secret-min-32-characters
JWT_EXPIRES_IN=1h
LEAD_SOURCE_API_KEY=please-change-this-api-key-min-32-chars
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
CORS_ORIGIN=http://localhost:3000
MONGODB_SYNC_INDEXES=true
CACHE_LIST_TTL_SECONDS=60
CACHE_LEAD_TTL_SECONDS=300
SEED_SALESPERSON_PASSWORD=please-change-this-seed-password

# lead-background-service
LEAD_BACKGROUND_SERVICE_PORT=3002
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=lead-background-service
KAFKA_GROUP_ID=lead-consumer
KAFKA_LEADS_TOPIC=leads.incoming
KAFKA_LEADS_DLQ_TOPIC=leads.incoming.dlq
CONSUMER_RETRY_ATTEMPTS=3
CONSUMER_RETRY_DELAY_MS=1000
ASSIGN_HELD_LEADS_INTERVAL_SECONDS=30
ASSIGN_HELD_LEADS_BATCH_SIZE=100

# e2e
E2E_SERVICE_URL=http://localhost:3001
E2E_WEB_URL=http://localhost:3000
E2E_LEAD_API_KEY=please-change-this-api-key-min-32-chars
E2E_KAFKA_BROKERS=localhost:9092
E2E_USER_A_EMAIL=sales.a@example.com
E2E_USER_B_EMAIL=sales.b@example.com
E2E_USER_PASSWORD=please-change-this-seed-password
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
HEADLESS=true
