{
  "name": "@lead/lead-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "pnpm nest build",
    "dev": "pnpm nest start --watch",
    "start": "node dist/src/main.js",
    "seed": "pnpm build && node dist/src/cli/seed.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm jest --runInBand --config jest.config.cjs",
    "test:integration": "pnpm jest --runInBand --config test/jest-integration.config.cjs"
  },
  "dependencies": {
    "@lead/persistence": "workspace:*",
    "@lead/shared-contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "^8.3.0",
    "ioredis": "5.8.2",
    "mongoose": "8.19.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.7.2",
    "@types/supertest": "6.0.3",
    "ajv": "^8.20.0",
    "jest": "30.2.0",
    "supertest": "7.1.4",
    "testcontainers": "11.7.2",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  }
}
