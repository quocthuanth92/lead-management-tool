{
  "name": "lead-management-tool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e --filter=@lead/e2e",
    "format": "prettier --ignore-unknown --write \"{apps,end-to-end,packages,scripts,.github/workflows,specs}/**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" \"{package.json,pnpm-workspace.yaml,turbo.json,tsconfig.base.json,README.md,docker-compose.yml,.env.example,.prettierrc.json,.gitignore,.dockerignore}\"",
    "format:check": "prettier --ignore-unknown --check \"{apps,end-to-end,packages,scripts,.github/workflows,specs}/**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" \"{package.json,pnpm-workspace.yaml,turbo.json,tsconfig.base.json,README.md,docker-compose.yml,.env.example,.prettierrc.json,.gitignore,.dockerignore}\"",
    "compose:up": "docker compose up --build --wait",
    "compose:down": "docker compose down -v",
    "verify:compose": "node scripts/verify-compose-health.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
