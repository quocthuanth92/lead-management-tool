  },
  "dependencies": {
    "@lead/shared-contracts": "workspace:*",
    "mongoose": "8.19.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.7.2",
    "jest": "30.2.0",
    "testcontainers": "11.7.2",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
