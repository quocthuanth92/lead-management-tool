{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["statusCode", "message", "error"],
  "additionalProperties": false,
  "properties": {
    "statusCode": { "type": "integer", "minimum": 400, "maximum": 599 },
    "message": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "error": { "type": "string" }
  }
}
